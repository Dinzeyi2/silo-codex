{
  "name": "@openai/silo",
  "version": "0.1.0",
  "description": "SILO: role-scoped multi-agent orchestrator for Codex. Each specialist role (database, auth, frontend, billing, intelligence, infrastructure) gets a Codex agent restricted to its own files, sharing a versioned architecture registry so specialists connect without stepping on each other.",
  "license": "Apache-2.0",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=18"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "silo": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "registry",
    "config"
  ],
  "sideEffects": false,
  "scripts": {
    "clean": "rm -rf dist",
    "build": "tsc -p tsconfig.build.json",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest",
    "test:watch": "NODE_OPTIONS=--experimental-vm-modules jest --watch",
    "coverage": "NODE_OPTIONS=--experimental-vm-modules jest --coverage",
    "lint": "pnpm eslint \"src/**/*.ts\" \"tests/**/*.ts\"",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "start": "node dist/server.js"
  },
  "dependencies": {
    "@openai/codex-sdk": "workspace:*",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "js-yaml": "^4.1.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.19.18",
    "jest": "^29.7.0",
    "prettier": "^3.6.2",
    "ts-jest": "^29.3.4",
    "typescript": "^5.9.2"
  },
  "packageManager": "pnpm@10.33.0+sha512.10568bb4a6afb58c9eb3630da90cc9516417abebd3fabbe6739f0ae795728da1491e9db5a544c76ad8eb7570f5c4bb3d6c637b2cb41bfdcdb47fa823c8649319"
}
